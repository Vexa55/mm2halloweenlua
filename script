-- ── FLY + COLLECT ─────────────────────────────────────────────
local function tryTouch(coin)
	if not rootPart or not coin or not coin.Parent then return end

	-- Prefer firetouchinterest (most reliable on executors)
	if typeof(firetouchinterest) == "function" then
		pcall(function()
			firetouchinterest(rootPart, coin, 0)
			task.wait()
			firetouchinterest(rootPart, coin, 1)
		end)
	end
end

local function flyTo(pos, speed)
	if not rootPart or not rootPart.Parent then return false end

	local dist = (pos - rootPart.Position).Magnitude
	if dist < 1.5 then return true end

	local tween = TweenService:Create(
		rootPart,
		TweenInfo.new(math.max(dist / speed, 0.05), Enum.EasingStyle.Linear),
		{ CFrame = CFrame.new(pos) }
	)
	tween:Play()

	local ok = pcall(function()
		tween.Completed:Wait()
	end)

	return ok and rootPart and rootPart.Parent
end

local function getClosestCoin()
	if not rootPart then return nil end

	local closest, shortest = nil, math.huge
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Coin_Server" and obj.CanTouch ~= false then
			if not visited[obj] then
				local dist = (obj.Position - rootPart.Position).Magnitude
				if dist < shortest and dist < 300 then
					closest = obj
					shortest = dist
				end
			end
		end
	end
	return closest
end

-- ── TOGGLE ────────────────────────────────────────────────────
toggleBtn.MouseButton1Click:Connect(function()
	isActive = not isActive
	toggleBtn.Text = isActive and "🎃 Auto Farm: ON" or "🎃 Auto Farm: OFF"
	toggleBtn.BackgroundColor3 = isActive and C.BtnOn or C.BtnOff

	if isActive then
		collected = 0
		startTime = tick()
		visited = {}
		counterLabel.Text = "🍬 Collected: 0"

		-- Timer
		task.spawn(function()
			while isActive do
				local elapsed = tick() - startTime
				timerLabel.Text = "⏱  Time Active: " .. math.floor(elapsed) .. "s"
				local rate = elapsed > 0 and math.floor((collected / elapsed) * 3600) or 0
				rateLabel.Text = "📈 Est. Coins/Hour: " .. rate
				task.wait(0.25)
			end
		end)

		-- Main farm loop
		task.spawn(function()
			while isActive do
				if not character or not character.Parent or not rootPart or not rootPart.Parent or humanoid.Health <= 0 then
					task.wait(0.5)
					continue
				end

				local coin = getClosestCoin()
				if coin and coin.Parent then
					local targetPos = coin.Position + Vector3.new(0, 1.5, 0) -- slight offset
					local reached = flyTo(targetPos, flySpeed)

					if reached and coin.Parent then
						tryTouch(coin)
						task.wait(0.08)
						tryTouch(coin)

						-- mark visited even if still there (prevent infinite loop on stuck coins)
						visited[coin] = true
						collected += 1
						if collectSound then collectSound:Play() end
						counterLabel.Text = "🍬 Collected: " .. collected
					else
						visited[coin] = true -- skip bad ones
					end
				else
					-- clean dead references occasionally
					for k in pairs(visited) do
						if not k.Parent then
							visited[k] = nil
						end
					end
					task.wait(0.3)
				end

				task.wait(0.05)
			end
		end)
	end
end)

